{
  "name": "chatimghub",
  "version": "1.0.0",
  "description": "A chat-style desktop app for multi-provider AI image generation",
  "main": "electron/main.cjs",
  "author": "zanllp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zanllp/ChatImgHub.git"
  },
  "bugs": {
    "url": "https://github.com/zanllp/ChatImgHub/issues"
  },
  "homepage": "https://github.com/zanllp/ChatImgHub#readme",
  "keywords": [
    "ai-image-generation",
    "multi-provider",
    "chat-interface",
    "electron",
    "text-to-image",
    "image-to-image",
    "gpt-image-2",
    "stable-diffusion-webui",
    "iib"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "dev:electron": "concurrently -k \"vite\" \"tsx watch server/index.ts\" \"wait-on tcp:5173 tcp:3210 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build": "vue-tsc && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "migrate": "node scripts/migrate-data.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@vueuse/core": "^14.1.0",
    "ant-design-vue": "^4.2.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "http-proxy-agent": "^5.0.0",
    "https-proxy-agent": "^5.0.1",
    "pinia": "^2.3.0",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.zanllp.chatimghub",
    "productName": "ChatImgHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
