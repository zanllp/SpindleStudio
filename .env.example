# All of these are optional seeds — everything can be configured in the app's
# settings page (stored in config.json, which takes priority over env).
# Priority: process env < .env < .env.local < config.json (in-app settings)

# API Mart (async task-based image generation, default provider)
APIMART_API_KEY=
# APIMART_BASE_URL=https://api.apimart.ai/v1

# OpenRouter (OpenAI-compatible sync image generation)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: OpenAI-compatible chat API, only used for the "AI title" feature
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: server port (default 3210)
# PORT=3210

# Optional: proxy for outbound API requests
# HTTPS_PROXY=http://127.0.0.1:7890
